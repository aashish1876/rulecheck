{
  "name": "rulecheck",
  "version": "0.1.2",
  "description": "Lint your AGENTS.md / CLAUDE.md / .cursorrules: catch stale paths, broken commands, duplicates, and conflicting rules.",
  "type": "module",
  "bin": {
    "rulecheck": "dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "selfcheck": "npm run build && node dist/cli.js . --ignore 'tests/fixtures/**'",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "mdast-util-from-markdown": "^2.0.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "author": "Aashish M",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aashish1876/rulecheck.git"
  },
  "bugs": {
    "url": "https://github.com/aashish1876/rulecheck/issues"
  },
  "homepage": "https://github.com/aashish1876/rulecheck#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "agents-md",
    "claude-md",
    "cursorrules",
    "ai",
    "coding-agents",
    "linter",
    "cli",
    "claude-code",
    "cursor",
    "codex"
  ]
}
